+                resp.text().await.unwrap_or_default(),
+            ));
+        }
+        let bytes = resp.bytes().await?;
+        if bytes.len() as u64 != end - start + 1 {
+            return Err(Error::ContentLength(format!(
+                "part {start}-{end}: expected {} bytes, got {}",
+                end - start + 1,
+                bytes.len()
+            )));
+        }
+        Ok(bytes)
+    }
