# readest-client-selfhost.patch — ywz626/readest-selfhosted 自托管客户端改动（甄选版）
# 基线: 官方 ac757777d fix(library): optimize bookshelf covers in background, closes #5632 (#5731) (merge-base, 2026-10 时官方领先该基线 478 提交)
# 提取: 2026-10-11 于 ywz master 87885d3e0
# 用法: git apply --3way docs/selfhosted/readest-client-selfhost.patch（需先 git fetch official main 提供 pre-image blob）
# 收录: 自托管核心（auth/supabase/access/environment/storage/transfer/登录UI/配额/分块下载健壮性）
# 排除: ywz 的 pinnedAt/libraryPinnedGroups/统计页/OPDS 功能、Android 品牌改造(com.ywz626.readest.sh)、
#       layout.tsx polyfill、locale 文件（登录 UI 英文回退，可按需补 zh-CN）、package.json/tauri.conf.json
#       （server 构建脚本与 SELFHOSTED env 由 .env.local + 手工脚本提供，见同目录 README.md）
#       src-tauri/Cargo.toml——ywz 的 tokio +time 已被官方吸收（官方现为 fs,net,sync,time），
#       该 hunk 重放会在 3way 下把官方行挤掉致编译失败（2026-10-11 Windows 出包抓到），勿再收录
# 重生成: 见本文件尾部维护命令注释
diff --git a/apps/readest-app/.env.server.example b/apps/readest-app/.env.server.example
new file mode 100644
index 000000000..497a996dd
--- /dev/null
+++ b/apps/readest-app/.env.server.example
@@ -0,0 +1,20 @@
+# ── 客户端：自建同步服务端模式（self-hosted server）──
+# 用法：复制本文件为 .env.server 后按需修改，再以对应脚本启动：
+#   cp .env.server.example .env.server
+#   pnpm dev-server        # 开发
+#   pnpm build-server      # 构建
+#   pnpm start-server      # 运行
+#
+# 开启自建模式后，客户端用「登录码」调自建服务端 POST /api/auth 换取 JWT，
+# 关闭时保留官方 Supabase 登录（不配置 NEXT_PUBLIC_SELFHOSTED 即可）。
+
+# ── 自建模式开关 ──
+# 设为 1 启用自建模式（代码登录 + 自建服务端的 JWT），关闭则保留官方 Supabase 登录
+NEXT_PUBLIC_SELFHOSTED=1
+
+# 自建服务端的 Base URL（不含 /api 后缀，客户端会自动追加 /api）
+# 例如：http://localhost:8080  或  https://sync.your-domain.com
+# 【可选】自托管安装包已支持「运行时输入服务端地址」：用户首次登录时在应用内
+# 填写地址即可，无需在此硬编码、也无需为每个用户单独编译。此处仅作为开发环境
+# 的默认值，应用内填写的地址优先级更高。
+NEXT_PUBLIC_API_BASE_URL=
